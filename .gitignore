# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

