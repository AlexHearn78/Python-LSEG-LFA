# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — never commit secrets.

# --- LSEG auth (consumed by lseg-analytics / lseg-data SDKs) ---
# LSEG_APP_KEY=your-app-key-here
# LSEG_PROFILE=default                  # optional: named profile in ~/.lseg/credentials.ini

# --- Override defaults from src/lseg_quant/config.py ---
# LSEG_DEFAULT_CALCULATION_DATE=2026-05-10
# LSEG_EUR_OIS_TEMPLATE_ID=c7a3eff1-abe8-4061-9f5e-83a76c09ee09
# LSEG_USD_OIS_TEMPLATE_ID=ce157336-e0c3-49e4-8b23-c1489bfb3c19
